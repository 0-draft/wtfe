---
/**
 * Every country on several scales in one figure: countries as rows, scales as columns, each cell a mini track with
 * one dot (Meyer: seven steps; Hofstede: 0-100). Small multiples replace reading strips one after another.
 * Same StripItem data as the vantage strip; cells link to the full strip read from that country.
 * With `theme`, a first column shows that theme's claims as confidence pips and rows link to the theme page sections.
 */
import { CULTURE_MAP_SCALES, type ThemeId } from "../data/schema.ts";
import { confidenceNames } from "../i18n/dict.ts";
import { shortPoles } from "../i18n/glance.ts";
import { type Lang, localePath } from "../i18n/ui.ts";
import { DISPLAY_CODE } from "../lib/codes.ts";
import { countries } from "../lib/content.ts";
import { type StripKey, scaleKind, spreadDomain } from "../lib/strip.ts";
import { scaleHref, scaleItems, scaleText } from "./strip/data.ts";

interface Props {
  lang: Lang;
  scales?: readonly StripKey[];
  theme?: ThemeId;
}
const { lang, scales = CULTURE_MAP_SCALES, theme } = Astro.props;

const text = {
  en: {
    meyer:
      "Culture Map cells are Erin Meyer's seven-step line, left pole to right pole. A hollow dot is placed from reviews, not her own chart; a bar spans a region's members. Positions are approximate and relative.",
    hofstede: "Hofstede cells run 0 to 100 and are country averages; most variation in values is within countries.",
    pips: "Claims: one square each. Filled = well attested, half = attested, outline = thin.",
    claims: "Claims",
    none: "no source",
    corner: "Country or region",
    cell: (scale: string, pos: string) => `${scale}: ${pos}`,
  },
  ja: {
    meyer:
      "Culture Map のマスは Erin Meyer の 7 段階の線で、左右がそれぞれの端です。白抜きの点は Meyer 本人の図ではなく書評などから置いた位置、横棒は地域内の国の幅。位置はおおよそで、相対的なものです。",
    hofstede: "Hofstede のマスは 0〜100 の国の平均値です。価値観のばらつきの大半は国の内側にあります。",
    pips: "記述：1 件につき四角 1 つ。塗り＝裏付け十分、半分＝裏付けあり、枠だけ＝裏付け薄。",
    claims: "記述",
    none: "出典なし",
    corner: "国・地域",
    cell: (scale: string, pos: string) => `${scale}：${pos}`,
  },
}[lang];
const fmtStep = (s: number) => (s > 0 ? `+${s}` : s < 0 ? `−${Math.abs(s)}` : "0");
const cols = scales.map((key) => {
  const t = scaleText(lang, key);
  const kind = scaleKind(key);
  const [left, right] = shortPoles[lang][key] ?? [t.left, t.right];
  const items = scaleItems(key);
  const { lo, hi } = spreadDomain(kind, items);
  const pct = (v: number) => ((v - lo) / (hi - lo)) * 100;
  const fmt = (v: number) => (kind === "meyer" ? fmtStep(v) : String(Math.round(v)));
  const byId = new Map(items.map((i) => [i.id, i]));
  return { key, kind, name: t.name, left, right, href: scaleHref(lang, key), byId, pct, fmt };
});
const order = { strong: 0, medium: 1, weak: 2 } as const;
const rows = countries(lang).map((c) => ({
  id: c.id,
  name: c.name,
  levels: theme ? c.themes[theme].map((cl) => cl.confidence).sort((a, b) => order[a] - order[b]) : [],
}));
const rowHref = (id: string) => (theme ? `#${id}` : localePath(lang, `/countries/${id}/`));
const minWidth = `${8.5 + (theme ? 7 : 0) + cols.length * 6}rem`;
const hasMeyer = cols.some((c) => c.kind === "meyer");
const hasHofstede = cols.some((c) => c.kind === "hofstede");
---

<figure class="mg">
  <div class="mg-scroll" tabindex="0" role="region" aria-label={text.corner}>
    <table class="mg-table" style={`min-inline-size:${minWidth}`}>
      <thead>
        <tr>
          <td class="mg-corner"><span class="sr-only">{text.corner}</span></td>
          {theme && (
            <th scope="col" class="mg-claims-h">
              {text.claims}
            </th>
          )}
          {
            cols.map((c) => (
              <th scope="col">
                <a href={c.href}>{c.name}</a>
                <span class="mg-poles">
                  <span>← {c.left}</span>
                  <span>{c.right} →</span>
                </span>
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          rows.map((r) => (
            <tr>
              <th scope="row">
                <a href={rowHref(r.id)}>
                  <span class="mg-name">{r.name}</span>
                  <span class="mg-code mono" aria-hidden="true">
                    {DISPLAY_CODE[r.id]}
                  </span>
                </a>
              </th>
              {theme && (
                <td class="mg-claims">
                  <span class="mg-pips" aria-hidden="true">
                    {r.levels.map((lv) => (
                      <span class="pip" data-level={lv} />
                    ))}
                  </span>
                  <span class="sr-only">
                    {r.levels.map((lv) => confidenceNames[lang][lv]).join(lang === "ja" ? "、" : ", ")}
                  </span>
                </td>
              )}
              {cols.map((c) => {
                const it = c.byId.get(r.id);
                const v = it?.value ?? null;
                const span =
                  it && it.members.length > 1
                    ? [Math.min(...it.members.map((m) => m.value)), Math.max(...it.members.map((m) => m.value))]
                    : null;
                return (
                  <td>
                    <a
                      class="mg-cell"
                      href={`${c.href}?from=${r.id}`}
                      aria-label={text.cell(c.name, v === null ? text.none : c.fmt(v))}
                    >
                      <span class="mg-line" aria-hidden="true">
                        {span && <span class="mg-span" style={`--a:${c.pct(span[0]!)}%;--b:${c.pct(span[1]!)}%`} />}
                        {v !== null ? (
                          <span class:list={["mg-dot", { "is-secondary": it?.secondary }]} style={`--x:${c.pct(v)}%`} />
                        ) : (
                          <span class="mg-none">—</span>
                        )}
                      </span>
                    </a>
                  </td>
                );
              })}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <figcaption class="mg-caption">
    {theme && <p>{text.pips}</p>}
    {hasMeyer && <p>{text.meyer}</p>}
    {hasHofstede && <p>{text.hofstede}</p>}
  </figcaption>
</figure>

<style>
  .mg {
    margin: 0;
  }
  .mg-scroll {
    overflow-x: auto;
  }
  .mg-table {
    inline-size: 100%;
    table-layout: fixed;
    border-collapse: separate;
    border-spacing: 0;
  }
  .mg-table th,
  .mg-table td {
    padding: 0;
    border-block-end: 1px solid var(--rule);
  }
  .mg-corner,
  .mg-table tbody th {
    inline-size: 8.5rem;
  }
  .mg-table thead th {
    vertical-align: bottom;
    padding: 0 0.375rem 0.5rem;
    border-block-end: 2px solid var(--ink);
    text-align: start;
    font-size: var(--s-14);
    line-height: 1.35;
  }
  .mg-table thead th a {
    display: block;
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    padding-block: 0.25rem;
  }
  .mg-table thead th a:hover {
    text-decoration: underline;
  }
  .mg-poles {
    display: flex;
    flex-direction: column;
    font-weight: 400;
    color: var(--ink-3);
  }
  .mg-poles span:last-child {
    text-align: end;
  }
  .mg-table tbody th {
    position: sticky;
    inset-inline-start: 0;
    z-index: 1;
    background: var(--paper);
    text-align: start;
  }
  .mg-table tbody th a {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    min-block-size: 2.5rem;
    padding: 0.5rem 0.5rem 0.5rem 0;
    font-size: var(--s-15);
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }
  .mg-code {
    flex: none;
    white-space: nowrap;
    color: var(--ink-3);
    font-weight: 400;
    font-size: var(--s-14);
  }
  .mg-table tbody tr:hover > * {
    background: var(--selected);
  }
  .mg-cell {
    display: flex;
    align-items: center;
    block-size: 2.5rem;
    padding-inline: 0.625rem;
    border-inline-start: 1px solid var(--rule);
    background: linear-gradient(to right, var(--wash-left) 50%, var(--wash-right) 50%);
  }
  .mg-table tbody tr:hover .mg-cell {
    background: var(--selected);
  }
  .mg-cell:focus-visible {
    outline-offset: -2px;
  }
  .mg-line {
    position: relative;
    display: block;
    inline-size: 100%;
    block-size: 0;
    border-block-start: 1px solid var(--axis);
  }
  .mg-dot {
    position: absolute;
    inset-block-start: -6.5px;
    inset-inline-start: var(--x);
    translate: -50% 0;
    inline-size: 12px;
    block-size: 12px;
    border-radius: 50%;
    background: var(--ink);
  }
  .mg-dot.is-secondary {
    background: var(--paper);
    border: 2px solid var(--ink);
  }
  .mg-span {
    position: absolute;
    inset-block-start: -2.5px;
    inset-inline-start: var(--a);
    inline-size: calc(var(--b) - var(--a));
    block-size: 4px;
    background: var(--ink-2);
  }
  .mg-none {
    position: absolute;
    inset-block-start: -0.75rem;
    inset-inline-start: 50%;
    translate: -50% 0;
    padding-inline: 0.25rem;
    font-size: var(--s-14);
    line-height: 1.5rem;
    color: var(--ink-3);
    background: var(--paper);
  }
  .mg-claims-h {
    inline-size: 7rem;
  }
  .mg-claims {
    vertical-align: middle;
    padding-inline: 0.5rem !important;
    border-inline-start: 1px solid var(--rule);
  }
  .mg-pips {
    display: flex;
    flex-wrap: wrap;
    gap: 3px;
  }
  .mg-caption p {
    margin: 0 0 0.25rem;
  }
  .mg-caption {
    margin-block-start: 0.75rem;
    max-inline-size: var(--measure);
    font-size: var(--s-14);
    color: var(--ink-3);
    line-height: 1.6;
  }
  @media (max-width: 40rem) {
    .mg-name {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .mg-corner,
    .mg-table tbody th {
      inline-size: 3.25rem;
    }
    .mg-cell {
      padding-inline: 0.5rem;
    }
  }
  @media (forced-colors: active) {
    .mg-dot {
      background: CanvasText;
    }
  }
</style>
