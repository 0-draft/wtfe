---
// Meyer and Hofstede vantage strips for one country page, with that country in 朱 (research/design.md, figure A).
import { type CountryId, CULTURE_MAP_SCALES, HOFSTEDE_DIMENSIONS } from "../data/schema.ts";
import { dict } from "../i18n/dict.ts";
import { stripText } from "../i18n/strip.ts";
import { type Lang, localePath } from "../i18n/ui.ts";
import Strip from "./strip/Strip.astro";

interface Props {
  lang: Lang;
  id: CountryId;
}
const { lang, id } = Astro.props;
const t = dict[lang];
const s = stripText[lang];
---

<div class="country-scales">
  <p class="section-lead">
    {s["scales.lead"]} <a href={localePath(lang, "/method/")}>{s["scales.method"]}</a>
  </p>
  <h3 id="scales-meyer">{t["country.cultureMap"]}</h3>
  {CULTURE_MAP_SCALES.map((k) => <Strip lang={lang} scale={k} focus={id} heading="h4" id={`strip-${k}`} />)}
  <h3 id="scales-hofstede">{t["country.hofstede"]}</h3>
  {HOFSTEDE_DIMENSIONS.map((k) => <Strip lang={lang} scale={k} focus={id} heading="h4" id={`strip-${k}`} />)}
</div>

<style>
  h3 {
    margin-block: 2.5rem 1rem;
  }
</style>
