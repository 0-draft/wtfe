---
/**
 * Evidence map (research/design.md, figure C): countries × themes, one rule per claim, weight = confidence.
 * A real table with counts in text. Without JavaScript each cell links to the country section; with it, a cell
 * opens a popover listing the claims, and the popover links on.
 */
import { CONFIDENCE, THEME_IDS } from "../data/schema.ts";
import { browse, themeCodes } from "../i18n/browse.ts";
import { confidenceNames, themeNames } from "../i18n/dict.ts";
import { type Lang, localePath } from "../i18n/ui.ts";
import { DISPLAY_CODE } from "../lib/codes.ts";
import { countries } from "../lib/content.ts";
import { evidenceMap, thinCells } from "../lib/evidence.ts";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const b = browse[lang];
const names = themeNames[lang];
const map = evidenceMap(countries(lang));
const nameOf = Object.fromEntries(map.rows.map((r) => [r.country.id, r.country.name]));
const sep = lang === "ja" ? "、" : "; ";
const thin = thinCells(map).map((c) => b["map.cellLabel"](nameOf[c.country]!, names[c.theme]));
const popId = (country: string, theme: string) => `em-${country}-${theme}`;
const snippet = (text: string) => {
  const max = lang === "ja" ? 70 : 140;
  return text.length > max ? `${text.slice(0, max).trimEnd()}…` : text;
};
---

<figure class="em" data-evidence-map>
  <div class="em-scroll" data-pagefind-ignore tabindex="0" role="region" aria-label={b["map.scroll"]}>
    <table class="em-table" aria-labelledby={`em-caption-${lang}`}>
      <colgroup>
        <col class="em-col-row" />
        {THEME_IDS.map(() => <col />)}
      </colgroup>
      <thead>
        <tr>
          <td class="em-corner"><span class="sr-only">{b["map.corner"]}</span></td>
          {
            THEME_IDS.map((th) => (
              <th scope="col">
                <a href={localePath(lang, `/themes/${th}/`)}>
                  <span class="em-long">{names[th]}</span>
                  <span class="em-short" aria-hidden="true" lang={lang}>
                    {themeCodes[lang][th]}
                  </span>
                </a>
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          map.rows.map((row) => (
            <tr>
              <th scope="row">
                <a href={localePath(lang, `/countries/${row.country.id}/`)}>
                  <span class="em-long">{row.country.name}</span>
                  <span class="em-code mono" aria-hidden="true">
                    {DISPLAY_CODE[row.country.id]}
                  </span>
                </a>
              </th>
              {row.cells.map((cell) => (
                <td>
                  <a
                    class="em-cell"
                    href={localePath(lang, `/countries/${cell.country}/#${cell.theme}`)}
                    data-pop={popId(cell.country, cell.theme)}
                  >
                    <span class="em-n mono">{cell.counts.total || "—"}</span>
                    <span class="sr-only">
                      {" "}
                      {b["map.cellName"](
                        cell.counts.total
                          ? b["map.counts"](cell.counts.strong, cell.counts.medium, cell.counts.weak)
                          : b["map.empty"],
                        b["map.cellLabel"](row.country.name, names[cell.theme]),
                      )}
                    </span>
                    <span class="em-rules" aria-hidden="true">
                      {cell.claims.map((c) => (
                        <span class="em-rule" data-level={c.confidence} />
                      ))}
                    </span>
                  </a>
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <figcaption class="em-caption" data-pagefind-ignore>
    <p id={`em-caption-${lang}`}>{b["map.caption"](map.counts.total, map.counts.strong, map.counts.medium, map.counts.weak)}</p>
    <p>{thin.length ? b["map.thinCells"](thin.join(sep)) : b["map.noThinCells"]}</p>
    <div class="em-keys">
      <dl class="em-legend" aria-label={b["map.legend"]}>
        {
          CONFIDENCE.map((lv) => (
            <div>
              <dt>
                <span class="em-rule" data-level={lv} />
              </dt>
              <dd class="usage" data-level={lv}>
                {confidenceNames[lang][lv]}
              </dd>
            </div>
          ))
        }
      </dl>
      <dl class="em-codes" aria-label={b["map.keyTitle"]}>
        {
          THEME_IDS.map((th) => (
            <div>
              <dt class={lang === "en" ? "mono" : ""}>{themeCodes[lang][th]}</dt>
              <dd>{names[th]}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </figcaption>
</figure>

<div class="em-pops" data-pagefind-ignore>
  {
    map.rows.flatMap((row) =>
      row.cells.map((cell) => (
        <div
          class="em-pop"
          id={popId(cell.country, cell.theme)}
          popover="auto"
          role="dialog"
          aria-labelledby={`${popId(cell.country, cell.theme)}-h`}
          tabindex="-1"
        >
          <div class="em-pop-head">
            <p class="em-pop-title" id={`${popId(cell.country, cell.theme)}-h`}>
              {b["map.cellLabel"](row.country.name, names[cell.theme])}
            </p>
            <button type="button" class="em-close" popovertarget={popId(cell.country, cell.theme)} popovertargetaction="hide">
              {b["map.close"]}
            </button>
          </div>
          <p class="em-pop-counts">{b["map.counts"](cell.counts.strong, cell.counts.medium, cell.counts.weak)}</p>
          <ul class="em-pop-list">
            {cell.claims.map((c) => (
              <li data-level={c.confidence}>
                <a href={localePath(lang, `/countries/${cell.country}/#${c.id}`)}>{snippet(c.text)}</a>
                <span class="usage" data-level={c.confidence}>
                  {confidenceNames[lang][c.confidence]}
                </span>
              </li>
            ))}
          </ul>
          <p class="em-pop-more">
            <a href={localePath(lang, `/countries/${cell.country}/#${cell.theme}`)}>
              {b["map.readAll"](row.country.name, names[cell.theme])} →
            </a>
          </p>
        </div>
      )),
    )
  }
</div>

<script>
  // Progressive enhancement: with JS (and popover support) a cell opens its claim list instead of navigating.
  for (const root of document.querySelectorAll<HTMLElement>("[data-evidence-map]")) {
    // The scroll container only needs a tab stop when it actually scrolls (narrow phones).
    const scroller = root.querySelector<HTMLElement>(".em-scroll");
    if (scroller) {
      const syncStop = () => {
        if (scroller.scrollWidth > scroller.clientWidth + 1) scroller.setAttribute("tabindex", "0");
        else scroller.removeAttribute("tabindex");
      };
      syncStop();
      addEventListener("resize", syncStop, { passive: true });
    }
    const cells = root.querySelectorAll<HTMLAnchorElement>("a[data-pop]");
    if (!cells.length || !("showPopover" in HTMLElement.prototype)) continue;
    let trigger: HTMLAnchorElement | null = null;

    const place = (pop: HTMLElement, cell: HTMLElement) => {
      if (matchMedia("(max-width: 40rem)").matches) {
        pop.style.removeProperty("left"); // bottom sheet via CSS
        pop.style.removeProperty("top");
        return;
      }
      // Never cover the cell that opened it: go below or above, whichever has room, and shrink to fit if neither does.
      pop.style.removeProperty("max-block-size");
      const r = cell.getBoundingClientRect();
      const w = pop.offsetWidth;
      const h = pop.offsetHeight;
      const left = Math.min(Math.max(8, r.left), innerWidth - w - 8);
      const roomBelow = innerHeight - r.bottom - 14;
      const roomAbove = r.top - 14;
      const goBelow = h <= roomBelow || (h > roomAbove && roomBelow >= roomAbove);
      const room = goBelow ? roomBelow : roomAbove;
      if (h > room) pop.style.maxBlockSize = `${Math.max(room, 160)}px`;
      const top = goBelow ? r.bottom + 6 : r.top - Math.min(h, Math.max(room, 160)) - 6;
      pop.style.left = `${left}px`;
      pop.style.top = `${Math.max(8, top)}px`;
    };

    for (const cell of cells) {
      const pop = document.getElementById(cell.dataset.pop ?? "");
      if (!pop) continue;
      cell.setAttribute("role", "button");
      cell.setAttribute("aria-haspopup", "dialog");
      cell.setAttribute("aria-expanded", "false");
      cell.setAttribute("aria-controls", pop.id);
      // popover="auto" light-dismisses on pointerup, before the click lands: remember whether it was open
      // when the press started, so a second tap on the same cell closes it instead of reopening it.
      let openAtPress: boolean | null = null;
      cell.addEventListener("pointerdown", () => {
        openAtPress = pop.matches(":popover-open");
      });
      const open = (e: Event) => {
        e.preventDefault();
        const wasOpen = openAtPress ?? pop.matches(":popover-open");
        openAtPress = null;
        if (wasOpen) {
          if (pop.matches(":popover-open")) pop.hidePopover();
          return;
        }
        trigger = cell;
        pop.showPopover();
        place(pop, cell);
        pop.focus();
      };
      cell.addEventListener("click", open);
      cell.addEventListener("keydown", (e) => {
        if (e.key === " ") open(e);
      });
      pop.addEventListener("toggle", (e) => {
        const isOpen = (e as ToggleEvent).newState === "open";
        cell.setAttribute("aria-expanded", String(isOpen));
        if (!isOpen && trigger === cell) {
          const inside = !document.activeElement || document.activeElement === document.body || pop.contains(document.activeElement);
          if (inside) cell.focus();
          trigger = null;
        }
      });
    }

    const reposition = () => {
      if (!trigger) return;
      const pop = document.getElementById(trigger.dataset.pop ?? "");
      if (pop?.matches(":popover-open")) place(pop, trigger);
    };
    addEventListener("scroll", reposition, { passive: true });
    addEventListener("resize", reposition);
  }
</script>

<style>
  .em {
    margin: 0;
  }
  .em-scroll {
    /* clip, not auto: keeps the sticky header tied to the viewport. Narrow phones fall back to scrolling below. */
    overflow-x: clip;
  }
  .em-scroll:focus-visible {
    outline-offset: 4px;
  }
  .em-table {
    inline-size: 100%;
    table-layout: fixed;
    border-collapse: separate;
    border-spacing: 0;
  }
  .em-col-row {
    inline-size: 11rem;
  }
  .em-table th,
  .em-table td {
    padding: 0;
    border-block-end: 1px solid var(--rule);
    vertical-align: top;
  }
  .em-table thead th,
  .em-corner {
    position: sticky;
    inset-block-start: 0;
    z-index: 2;
    background: var(--paper);
    border-block-end: 2px solid var(--ink);
    vertical-align: bottom;
  }
  .em-table thead th a {
    display: flex;
    align-items: flex-end;
    min-block-size: 2.75rem;
    padding: 0.375rem 0.5rem 0.375rem 0.375rem;
    font-size: var(--s-14);
    font-weight: 600;
    line-height: 1.35;
    color: var(--ink);
    text-decoration: none;
  }
  .em-table thead th a:hover {
    text-decoration: underline;
  }
  .em-table tbody th {
    position: sticky;
    inset-inline-start: 0;
    z-index: 1;
    background: var(--paper);
    text-align: start;
  }
  .em-table tbody th a {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0 0.5rem;
    min-block-size: 2.75rem;
    block-size: 100%;
    padding: 0.5rem 0.5rem 0.5rem 0;
    font-size: var(--s-15);
    font-weight: 600;
    text-decoration: none;
  }
  .em-table tbody th a:hover .em-long {
    text-decoration: underline;
  }
  .em-code {
    color: var(--ink-3);
    font-weight: 400;
    font-size: var(--s-14);
  }
  .em-short {
    display: none;
  }
  .em-table tbody tr:hover > *,
  .em-table tbody tr:has([aria-expanded="true"]) > * {
    background: var(--selected);
  }

  .em-cell {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    block-size: 3.25rem;
    padding: 0.5rem 0.625rem 0.375rem 0.375rem;
    text-decoration: none;
    color: var(--ink);
    border-inline-start: 1px solid var(--rule);
  }
  .em-cell:hover .em-n,
  .em-cell[aria-expanded="true"] .em-n {
    text-decoration: underline;
    color: var(--ink);
  }
  .em-cell:focus-visible {
    outline-offset: -2px;
  }
  .em-n {
    flex: none;
    min-inline-size: 1ch;
    font-size: var(--s-14);
    line-height: 1;
    color: var(--ink-2);
  }
  .em-rules {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding-block-start: 0.125rem;
  }
  /* Same visual language as the Claim entry's left rule: thick solid / thin solid / dashed. Borders survive forced colours. */
  .em-rule {
    display: block;
    inline-size: 100%;
    block-size: 0;
    border-block-start: 3px solid var(--ink);
  }
  .em-rule[data-level="medium"] {
    border-block-start: 1.5px solid var(--ink-2);
  }
  .em-rule[data-level="weak"] {
    border-block-start: 1.5px dashed var(--ink-3);
  }

  .em-caption {
    margin-block-start: 1rem;
    font-size: var(--s-15);
    color: var(--ink-2);
    max-inline-size: var(--measure);
  }
  .em-caption p {
    margin-block-end: 0.5rem;
  }
  .em-keys {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    margin-block-start: 0.75rem;
  }
  .em-keys dl {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0;
  }
  .em-keys dl > div {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .em-keys dd {
    margin: 0;
  }
  .em-legend dt {
    inline-size: 2rem;
  }
  .em-keys .em-codes {
    display: none;
  }
  .em-codes dt {
    font-weight: 600;
    color: var(--ink);
    font-size: var(--s-14);
  }

  .em-pop {
    position: fixed;
    inset: auto;
    margin: 0;
    inline-size: min(24rem, calc(100vw - 1rem));
    max-block-size: min(28rem, 70vh);
    overflow-y: auto;
    padding: 0.875rem 1rem 1rem;
    background: var(--raised);
    color: var(--ink);
    border: 1px solid var(--ink);
    border-radius: 2px;
    font-size: var(--s-15);
    opacity: 0;
    transition:
      opacity 120ms,
      display 120ms allow-discrete,
      overlay 120ms allow-discrete;
  }
  .em-pop:popover-open {
    opacity: 1;
  }
  @supports not selector(:popover-open) {
    .em-pop {
      display: none;
    }
  }
  @starting-style {
    .em-pop:popover-open {
      opacity: 0;
    }
  }
  .em-pop:focus-visible {
    outline: 2px solid var(--shu);
  }
  .em-pop-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .em-pop-title {
    margin: 0;
    font-family: var(--f-head);
    font-weight: 700;
    font-size: var(--s-17);
  }
  .em-close {
    flex: none;
    font: inherit;
    font-size: var(--s-14);
    min-block-size: 2.75rem;
    min-inline-size: 2.75rem;
    padding: 0 0.5rem;
    color: var(--ink-2);
    background: none;
    border: 1px solid var(--axis);
    border-radius: 2px;
    cursor: pointer;
  }
  .em-pop-counts {
    margin: 0.25rem 0 0.75rem;
    font-size: var(--s-14);
    color: var(--ink-2);
  }
  .em-pop-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .em-pop-list li {
    padding: 0.25rem 0 0.25rem 0.75rem;
    margin-block-end: 0.5rem;
    border-inline-start: 3px solid var(--ink);
    line-height: 1.5;
  }
  .em-pop-list li[data-level="medium"] {
    border-inline-start: 1.5px solid var(--ink-2);
  }
  .em-pop-list li[data-level="weak"] {
    border-inline-start: 1.5px dashed var(--ink-3);
  }
  .em-pop-list a {
    display: block;
  }
  .em-pop-more {
    margin: 0.75rem 0 0;
    font-weight: 600;
  }

  @media (max-width: 56rem) {
    .em-col-row {
      inline-size: 4.5rem;
    }
    .em-long {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .em-short {
      display: inline;
    }
    .em-short:lang(en) {
      font-family: var(--f-mono);
      font-weight: 500;
    }
    .em-table thead th a {
      justify-content: center;
      padding-inline: 0;
    }
    .em-table tbody th a {
      align-items: center;
    }
    .em-code {
      color: var(--ink);
      font-weight: 500;
    }
    .em-cell {
      flex-direction: column;
      align-items: stretch;
      gap: 0.375rem;
      block-size: 4rem;
      padding: 0.375rem 0.375rem 0.25rem;
    }
    .em-keys .em-codes {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 11rem), 1fr));
      gap: 0.25rem 1rem;
      inline-size: 100%;
    }
    .em-codes dt {
      min-inline-size: 2.75rem;
    }
  }
  @media (max-width: 24.25rem) {
    /* Below ~388px seven 44px columns no longer fit: scroll inside the figure, row headers stay put. */
    .em-scroll {
      overflow-x: auto;
    }
    .em-table {
      min-inline-size: calc(4.5rem + 7 * 2.75rem);
    }
  }
  @media (max-width: 40rem) {
    .em-pop {
      inset: auto 0 0 0;
      inline-size: 100%;
      max-block-size: 75vh;
      border-inline: 0;
      border-block-end: 0;
      padding-block-end: calc(1rem + env(safe-area-inset-bottom));
    }
    /* A bottom sheet needs the page behind it set back, or the two read as one surface. */
    .em-pop::backdrop {
      background: rgb(0 0 0 / 0.28);
    }
  }
</style>
