---
import { COUNTRY_IDS, type CountryId } from "../data/schema.ts";
import { type Lang, localePath } from "../i18n/ui.ts";
import { DISPLAY_CODE } from "../lib/codes.ts";
import { country } from "../lib/content.ts";

interface Props {
  lang: Lang;
  current?: CountryId;
  /** Path template; `{id}` is replaced. Defaults to the country page. */
  href?: string;
}
const { lang, current, href = "/countries/{id}/" } = Astro.props;
---

<nav class="thumb-index" data-pagefind-ignore aria-label={lang === "ja" ? "国の索引" : "Country index"}>
  {
    COUNTRY_IDS.map((id) => (
      <a
        href={localePath(lang, href.replace("{id}", id))}
        aria-current={id === current ? "page" : undefined}
        title={country(lang, id)?.name}
      >
        {DISPLAY_CODE[id]}
      </a>
    ))
  }
</nav>

<script>
  // On pages where the tabs jump within the page (a theme page), mark the tab of the country section being read,
  // the way a dictionary's thumb index shows which letter you are in.
  for (const nav of document.querySelectorAll<HTMLElement>(".thumb-index")) {
    const tabs = [...nav.querySelectorAll<HTMLAnchorElement>("a")].filter(
      (a) => a.hash && a.pathname === location.pathname,
    );
    const targets = tabs
      .map((a) => [a, document.getElementById(decodeURIComponent(a.hash.slice(1)))] as const)
      .filter((p): p is readonly [HTMLAnchorElement, HTMLElement] => p[1] !== null);
    if (!targets.length || !("IntersectionObserver" in window)) continue;
    const mark = (tab: HTMLAnchorElement | undefined) => {
      for (const [a] of targets) {
        if (a === tab) a.setAttribute("aria-current", "location");
        else a.removeAttribute("aria-current");
      }
    };
    const io = new IntersectionObserver(
      (entries) => {
        // Sections that are not countries (definition, scales) clear the mark.
        for (const e of entries) if (e.isIntersecting) mark(targets.find(([, el]) => el === e.target)?.[0]);
      },
      { rootMargin: "0px 0px -80% 0px" },
    );
    for (const el of document.querySelectorAll("main [data-rh]")) io.observe(el);
  }
</script>
