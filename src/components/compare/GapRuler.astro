---
/**
 * Signature figure B, the gap ruler (research/design.md). One mini strip per scale: the vantage country (A) as a
 * filled 朱 dot, the other (B) as a hollow 藍 ring, a bracket between them and a sentence. Static SVG; every strip
 * has a text equivalent. Meyer's eight scales are grouped and sorted by gap; Hofstede's six follow in their own block.
 */
import type { CultureMapScale, HofstedeDimension } from "../../data/schema.ts";
import { compareDict } from "../../i18n/compare.ts";
import { cultureMapText, hofstedeText, scaleSlug } from "../../i18n/scales.ts";
import { stripText } from "../../i18n/strip.ts";
import { type Lang, localePath } from "../../i18n/ui.ts";
import { DISPLAY_CODE } from "../../lib/codes.ts";
import { hofstedeMembers, isRegion } from "../../lib/compare.ts";
import {
  type GapLine,
  groupLines,
  hofstedeLines,
  memberBreakdown,
  meyerLines,
  noneGroups,
  positionsText,
  regionNote,
  type Side,
} from "../../lib/compare-text.ts";
import { formatSigned } from "../../lib/strip.ts";
import { parseMemberSteps } from "../../lib/strip-items.ts";
import RulerStrip from "./RulerStrip.astro";
import { pct, type RulerRow } from "./ruler.ts";

interface Props {
  lang: Lang;
  a: Side;
  b: Side;
}
const { lang, a, b } = Astro.props;
const t = compareDict[lang];

const meyer = groupLines(meyerLines(lang, a, b));
const hofstede = hofstedeLines(lang, a, b);
const hofScored = hofstede.filter((l) => l.group !== "none");
const hofMissing = hofstede.filter((l) => l.group === "none");

/** The Hofstede line runs to 100, or to the next ten above the highest score drawn (members included). */
const hofTop = Math.max(
  100,
  ...[a, b].flatMap((side) => side.meta.hofstede.flatMap((h) => Object.values(h.scores).map((v) => v ?? 0))),
  ...hofstede.flatMap((l) => [l.a ?? 0, l.b ?? 0]),
);
const hofMax = hofTop > 100 ? Math.ceil(hofTop / 10) * 10 : 100;
const fmtNum = (n: number) => new Intl.NumberFormat(lang === "ja" ? "ja" : "en-GB").format(n);

const secondary = (side: Side, key: CultureMapScale) => side.meta.cultureMap[key].basis === "secondary";
/** A region's per-member steps ("DK −1, FI −1"), parsed the same way as on the vantage strip. */
const memberNote = (side: Side, key: CultureMapScale) => {
  if (!isRegion(side.meta) || side.meta.cultureMap[key].step === null) return null;
  const members = parseMemberSteps(side.meta.cultureMap[key].note, side.meta.iso);
  return members.length
    ? t["ruler.members"](
        DISPLAY_CODE[side.id],
        members.map((m) => `${m.code} ${formatSigned(m.value, lang)}`).join(lang === "ja" ? "、" : ", "),
      )
    : null;
};

function meyerStrip(line: GapLine<CultureMapScale>): RulerRow {
  const k = line.key;
  return {
    key: k,
    kind: "meyer",
    text: cultureMapText[lang][k],
    line,
    xa: line.a === null ? null : pct(line.a, -3, 3),
    xb: line.b === null ? null : pct(line.b, -3, 3),
    ticks: [-3, -2, -1, 0, 1, 2, 3].map((s) => pct(s, -3, 3)),
    ends: ["−3", "+3"],
    codeA: DISPLAY_CODE[a.id] + (secondary(a, k) ? "†" : ""),
    codeB: DISPLAY_CODE[b.id] + (secondary(b, k) ? "†" : ""),
    members: [],
    notes: [memberNote(a, k), memberNote(b, k)].filter((n): n is string => n !== null),
  };
}

function hofstedeStrip(line: GapLine<HofstedeDimension>): RulerRow {
  const k = line.key;
  const regionTicks = (side: Side, which: "a" | "b"): [number, "a" | "b"][] =>
    isRegion(side.meta) ? hofstedeMembers(side.meta)[k].map((m) => [pct(m.score, 0, hofMax), which]) : [];
  return {
    key: k,
    kind: "hofstede",
    text: hofstedeText[lang][k],
    line,
    xa: line.a === null ? null : pct(line.a, 0, hofMax),
    xb: line.b === null ? null : pct(line.b, 0, hofMax),
    ticks: [0, 50, 100, ...(hofMax > 100 ? [hofMax] : [])].map((v) => pct(v, 0, hofMax)),
    ends: ["0", fmtNum(hofMax)],
    codeA: DISPLAY_CODE[a.id],
    codeB: DISPLAY_CODE[b.id],
    members: [...regionTicks(a, "a"), ...regionTicks(b, "b")],
    notes: [memberBreakdown(lang, a, k), memberBreakdown(lang, b, k)].filter((n): n is string => n !== null),
  };
}

const groups = [
  ["different", t["group.different"], meyer.different.map(meyerStrip)],
  ["close", t["group.close"], meyer.close.map(meyerStrip)],
] as const;
const hofStrips = hofScored.map(hofstedeStrip);
const regionNotes = [regionNote(lang, a), regionNote(lang, b)].filter((n): n is string => n !== null);
const hofSource = a.meta.hofstede[0]?.source ?? b.meta.hofstede[0]?.source;
const scaleHref = (s: RulerRow) => localePath(lang, `/scales/${scaleSlug(s.key as CultureMapScale, s.kind)}/`);
const scaleId = (s: RulerRow) => `gap-${s.kind}-${s.key}`;
const noneMeyer = noneGroups(lang, meyer.none, a, b);
/** Hofstede rows without a score, merged when they say the same thing. */
const noneHof: { keys: HofstedeDimension[]; sentence: string }[] = [];
for (const l of hofMissing) {
  const g = noneHof.find((x) => x.sentence === l.sentence);
  if (g) g.keys.push(l.key);
  else noneHof.push({ keys: [l.key], sentence: l.sentence });
}
const sepList = lang === "ja" ? "、" : ", ";
const st = stripText[lang];
---
<figure class="ruler" data-pagefind-ignore aria-labelledby="ruler-meyer" data-rh={t["ruler.heading"]}>
  <h2 id="ruler-meyer" class="ruler-h">{t["ruler.heading"]}</h2>
  <p class="section-lead">{t["ruler.lead"](a.noun.object, b.noun.object)}</p>
  <p class="legend">
    <span class="key">
      <svg class="key-mark" width="20" height="20" aria-hidden="true"><circle class="m-a" cx="10" cy="10" r="7"></circle></svg>
      <span>{t["ruler.legendA"](a.noun.object)}</span>
    </span>
    <span class="key">
      <svg class="key-mark" width="20" height="20" aria-hidden="true"><circle class="m-b" cx="10" cy="10" r="7"></circle></svg>
      <span>{t["ruler.legendB"](b.noun.object)}</span>
    </span>
  </p>
  {
    groups.map(
      ([id, heading, strips]) =>
        strips.length > 0 && (
          <section class="group" aria-labelledby={`g-${id}`} data-group={id}>
            <h3 id={`g-${id}`}>
              {heading}
              <span class="h-count">{t["group.count"](strips.length)}</span>
            </h3>
            <ol class="rows">
              {strips.map((s) => (
                <li class="row" aria-labelledby={scaleId(s)}>
                  <div class="row-text">
                    <h4 id={scaleId(s)} class="row-scale">
                      <a href={scaleHref(s)}>{s.text.name}</a>
                    </h4>
                    <p class="row-sentence">{s.line.sentence}</p>
                    {s.notes.map((n) => (
                      <p class="row-note">{n}</p>
                    ))}
                  </div>
                  <RulerStrip row={s} label={positionsText(lang, "meyer", s.line, a, b, s.text)} />
                </li>
              ))}
            </ol>
          </section>
        ),
    )
  }
  {
    noneMeyer.length > 0 && (
      <section class="group" aria-labelledby="g-none" data-group="none">
        <h3 id="g-none">
          {t["group.none"]}
          <span class="h-count">{t["group.count"](meyer.none.length)}</span>
        </h3>
        <p class="group-lead">{t["group.noneLead"]}</p>
        <ul class="none-list">
          {noneMeyer.map((g) => (
            <li>
              <span class="none-names">
                {g.keys.map((k, i) => (
                  <>
                    {i > 0 && sepList}
                    <a href={localePath(lang, `/scales/${scaleSlug(k, "meyer")}/`)}>{cultureMapText[lang][k].name}</a>
                  </>
                ))}
              </span>
              <span class="none-sentence">{g.sentence}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }
  <figcaption class="prov">
    {meyer.different.concat(meyer.close).some((l) => secondary(a, l.key) || secondary(b, l.key)) && (
      <span class="prov-line">{t["ruler.secondary"]}</span>
    )}
    <span class="prov-line">
      {t["ruler.provenance"]} <a href={localePath(lang, "/method/#culture-map")}>{t["ruler.how"]}</a>
    </span>
  </figcaption>
</figure>

<figure class="ruler" data-pagefind-ignore aria-labelledby="ruler-hofstede" data-rh={t["hofstede.heading"]}>
  <h2 id="ruler-hofstede" class="ruler-h">{t["hofstede.heading"]}</h2>
  <p class="section-lead">{t["hofstede.lead"](a.noun.object, b.noun.object)}</p>
  {regionNotes.map((n) => <p class="region-note">{n}</p>)}
  {hofMax > 100 && <p class="region-note">{st["strip.extended"](hofMax)}</p>}
  <ol class="rows">
    {
      hofStrips.map((s) => (
        <li class="row" aria-labelledby={scaleId(s)}>
          <div class="row-text">
            <h3 id={scaleId(s)} class="row-scale">
              <a href={scaleHref(s)}>{s.text.name}</a>
            </h3>
            <p class="row-sentence">{s.line.sentence}</p>
            {s.notes.map((n) => (
              <p class="row-note">{n}</p>
            ))}
          </div>
          <RulerStrip row={s} label={positionsText(lang, "hofstede", s.line, a, b, s.text, hofMax)} />
        </li>
      ))
    }
  </ol>
  {
    noneHof.length > 0 && (
      <ul class="none-list">
        {noneHof.map((g) => (
          <li>
            <span class="none-names">
              {g.keys.map((k, i) => (
                <>
                  {i > 0 && sepList}
                  <a href={localePath(lang, `/scales/${scaleSlug(k, "hofstede")}/`)}>{hofstedeText[lang][k].name}</a>
                </>
              ))}
            </span>
            <span class="none-sentence">{g.sentence}</span>
          </li>
        ))}
      </ul>
    )
  }
  <figcaption class="prov">
    <span class="prov-line">{st["strip.taras"]}</span>
    {hofSource && <span class="prov-line">{t["hofstede.provenance"](hofSource.title, String(hofSource.year ?? ""))}</span>}
    <span class="prov-line"><a href={localePath(lang, "/method/#hofstede")}>{t["hofstede.how"]}</a></span>
  </figcaption>
</figure>

<style>
  .ruler {
    margin: 3.5rem 0 0;
  }
  .ruler-h {
    padding-block-start: 0.75rem;
    border-block-start: 1px solid var(--ink);
    margin-block-end: 0.75rem;
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    font-size: var(--s-15);
    color: var(--ink-2);
  }
  .key {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
  }
  .key-mark {
    flex: none;
  }
  .group {
    margin-block-start: 2rem;
  }
  .group h3 {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    font-family: var(--f-head);
    font-weight: 700;
  }
  .h-count {
    font-family: var(--f-body);
    font-size: var(--s-14);
    font-weight: 600;
    color: var(--ink-2);
  }
  .group-lead {
    color: var(--ink-2);
    font-size: var(--s-15);
    max-inline-size: var(--measure);
    margin-block: 0.25rem 0.5rem;
  }
  .rows {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 0.5rem 2rem;
    align-items: center;
    padding-block: 0.875rem;
    border-block-end: 1px solid var(--rule);
  }
  .row:first-child {
    border-block-start: 1px solid var(--rule);
  }
  .row-scale {
    font-family: var(--f-body);
    font-size: var(--s-14);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin: 0;
  }
  .row-scale:lang(ja) {
    letter-spacing: 0;
  }
  .row-scale a {
    display: inline-block;
    padding-block: 0.625rem;
    margin-block: -0.625rem;
  }
  .row-sentence {
    margin: 0.25rem 0 0;
    font-size: var(--s-17);
  }
  .row-note {
    margin: 0.25rem 0 0;
    font-size: var(--s-14);
    color: var(--ink-2);
  }
  .m-a {
    fill: var(--shu);
    stroke: var(--paper);
    stroke-width: 1.5;
  }
  .m-b {
    fill: var(--paper);
    stroke: var(--ai);
    stroke-width: 2.5;
  }
  .none-list {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
  }
  .none-list li {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
    align-items: baseline;
    padding-block: 0.5rem;
    border-block-end: 1px dashed var(--rule);
    color: var(--ink-2);
  }
  .none-list a {
    font-weight: 600;
    color: var(--ink);
    padding-block: 0.5rem;
    margin-block: -0.5rem;
  }
  .region-note {
    max-inline-size: var(--measure);
    font-size: var(--s-15);
    color: var(--ink-2);
    margin-block: 0.25rem;
  }
  .prov {
    display: grid;
    gap: 0.25rem;
    margin-block-start: 1rem;
    font-size: var(--s-15);
    line-height: 1.6;
    color: var(--ink-2);
    max-inline-size: var(--measure);
  }
  .prov a {
    display: inline-block;
    padding-block: 0.625rem;
    margin-block: -0.625rem;
  }
  @media (max-width: 44rem) {
    .row {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
