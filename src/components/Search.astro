---
/**
 * Site search: a header button and a native <dialog> command palette over the Pagefind index built in `postbuild`.
 * Pagefind is loaded only when the palette first opens; under `astro dev` the bundle does not exist and the palette
 * says so in one line. Results come from the index of the current page's language only (Pagefind splits by <html lang>).
 */
import { search } from "../i18n/search.ts";
import type { Lang } from "../i18n/ui.ts";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = search[lang];
const strings = {
  idle: s.idle,
  loading: s.loading,
  none: s.none("{q}"),
  count: [s.count(1), s.count("{n}")],
  more: s.more("{shown}", "{total}"),
  unavailable: s.unavailable,
  failed: s.failed,
  kinds: s.kinds,
};
---

<button class="search-open" type="button" data-search-open aria-haspopup="dialog" aria-controls="search" hidden>
  <svg class="glass" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false">
    <circle cx="8.5" cy="8.5" r="5.75" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
    <path d="M12.7 12.7 17.5 17.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="square"></path>
  </svg>
  <span>{s.open}</span>
  <kbd class="hint" aria-hidden="true">/</kbd>
</button>

<dialog
  id="search"
  class="search"
  aria-label={s.dialog}
  data-search
  data-base={import.meta.env.BASE_URL}
  data-strings={JSON.stringify(strings)}
>
  <div class="s-bar">
    <svg class="glass" viewBox="0 0 20 20" width="22" height="22" aria-hidden="true" focusable="false">
      <circle cx="8.5" cy="8.5" r="5.75" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
      <path d="M12.7 12.7 17.5 17.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="square"></path>
    </svg>
    <input
      class="s-input"
      type="search"
      role="combobox"
      aria-label={s.dialog}
      aria-expanded="false"
      aria-controls="search-results"
      aria-autocomplete="list"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      enterkeyhint="go"
      placeholder={s.placeholder}
      data-search-input
    />
    <button class="s-close" type="button" data-search-close>
      <kbd class="s-esc" aria-hidden="true">esc</kbd>
      <span class="s-close-text">{s.close}</span>
    </button>
  </div>
  <ol id="search-results" class="s-results" role="listbox" aria-label={s.results} data-search-results></ol>
  <div class="s-foot">
    <p class="s-status" role="status" data-search-status>{s.idle}</p>
    <p class="s-keys" aria-hidden="true">
      {
        s.keys.map(([key, action]) => (
          <span>
            <kbd>{key}</kbd> {action}
          </span>
        ))
      }
    </p>
  </div>
</dialog>

<script>
  interface PagefindResultData {
    url: string;
    excerpt: string;
    meta: Record<string, string | undefined>;
    sub_results?: { title: string; url: string; excerpt: string }[];
  }
  interface PagefindResult {
    id: string;
    score: number;
    data: () => Promise<PagefindResultData>;
  }
  interface Pagefind {
    options: (o: Record<string, unknown>) => Promise<void>;
    init: () => Promise<void>;
    search: (q: string, o?: { filters?: Record<string, string> }) => Promise<{ results: PagefindResult[] } | null>;
  }
  interface Strings {
    idle: string;
    loading: string;
    none: string;
    count: [string, string];
    more: string;
    unavailable: string;
    failed: string;
    kinds: Record<string, string>;
  }

  const LIMIT = 12;
  const DEBOUNCE = 130;
  /**
   * 364 compare pages repeat both countries' names in their headings and are short, so Pagefind ranks them above the
   * country entries for a bare country name. Scale their scores down; a query naming both countries still finds its pair.
   */
  const COMPARE_WEIGHT = 0.1;

  const dialog = document.querySelector<HTMLDialogElement>("[data-search]");
  const openers = document.querySelectorAll<HTMLButtonElement>("[data-search-open]");
  const input = dialog?.querySelector<HTMLInputElement>("[data-search-input]");
  const list = dialog?.querySelector<HTMLOListElement>("[data-search-results]");
  const status = dialog?.querySelector<HTMLElement>("[data-search-status]");

  if (dialog && input && list && status && typeof dialog.showModal === "function") {
    const str = JSON.parse(dialog.dataset.strings ?? "{}") as Strings;
    const base = dialog.dataset.base ?? "/";
    let pagefind: Promise<Pagefind | null> | undefined;
    let timer: ReturnType<typeof setTimeout> | undefined;
    let seq = 0;
    let active = -1;

    const fill = (tpl: string, vars: Record<string, string | number>) =>
      tpl.replace(/\{(\w+)\}/g, (_, k: string) => String(vars[k] ?? ""));
    const say = (text: string) => {
      status.textContent = text;
    };

    const load = () => {
      pagefind ??= (async () => {
        try {
          const url = `${base}pagefind/pagefind.js`;
          const pf = (await import(/* @vite-ignore */ url)) as Pagefind;
          await pf.options({ baseUrl: base, excerptLength: 22 });
          await pf.init();
          return pf;
        } catch {
          say(import.meta.env.DEV ? str.unavailable : str.failed);
          return null;
        }
      })();
      return pagefind;
    };

    const options = () => [...list.querySelectorAll<HTMLAnchorElement>("[role=option]")];
    const select = (i: number, scroll = true) => {
      const opts = options();
      active = opts.length ? (i + opts.length) % opts.length : -1;
      opts.forEach((o, j) => o.setAttribute("aria-selected", String(j === active)));
      const cur = opts[active];
      if (cur) {
        input.setAttribute("aria-activedescendant", cur.id);
        if (scroll) cur.scrollIntoView({ block: "nearest" });
      } else input.removeAttribute("aria-activedescendant");
    };

    /** Pagefind excerpts are escaped text with <mark> around matches; rebuild them from text and <mark> nodes only. */
    const excerpt = (html: string) => {
      const out = document.createElement("span");
      out.className = "s-excerpt";
      const doc = new DOMParser().parseFromString(`<p>${html}</p>`, "text/html");
      for (const n of doc.body.firstChild?.childNodes ?? []) {
        if (n.nodeName === "MARK") {
          const m = document.createElement("mark");
          m.textContent = n.textContent;
          out.append(m);
        } else out.append(n.textContent ?? "");
      }
      return out;
    };

    const row = (d: PagefindResultData, i: number, terms: string[]) => {
      // When the query does not name the page itself, open the section that matched (a country's theme, a method
      // chapter) and show its heading next to the page title, like a running head.
      const title = (d.meta.title ?? "").toLocaleLowerCase();
      const named = terms.some((w) => title.includes(w));
      const sub = named ? undefined : d.sub_results?.find((r) => r.url.includes("#") && r.title !== d.meta.title);
      const li = document.createElement("li");
      li.setAttribute("role", "none");
      const a = document.createElement("a");
      a.id = `search-opt-${i}`;
      a.href = sub?.url ?? d.url;
      a.tabIndex = -1;
      a.setAttribute("role", "option");
      a.setAttribute("aria-selected", "false");
      const kind = document.createElement("span");
      kind.className = "s-kind";
      kind.textContent = str.kinds[d.meta.kind ?? ""] ?? "";
      const body = document.createElement("span");
      body.className = "s-body";
      const head = document.createElement("span");
      head.className = "s-title";
      const word = document.createElement("span");
      word.className = "s-word";
      word.textContent = d.meta.title ?? d.url;
      head.append(word);
      if (sub) {
        const where = document.createElement("span");
        where.className = "s-where";
        where.textContent = sub.title;
        head.append(where);
      }
      body.append(head, excerpt(sub?.excerpt ?? d.excerpt));
      a.append(kind, body);
      a.addEventListener("mousemove", () => {
        if (active !== i) select(i, false);
      });
      li.append(a);
      return li;
    };

    const clear = () => {
      list.replaceChildren();
      input.setAttribute("aria-expanded", "false");
      select(-1);
    };

    const run = async (q: string) => {
      const mine = ++seq;
      if (!q.trim()) {
        clear();
        say(str.idle);
        return;
      }
      const pf = await load();
      if (!pf || mine !== seq) return;
      const [res, cmp] = await Promise.all([pf.search(q), pf.search(q, { filters: { kind: "compare" } })]);
      if (!res || mine !== seq) return;
      const isCompare = new Set(cmp?.results.map((r) => r.id));
      const ranked = res.results
        .map((r) => ({ r, score: r.score * (isCompare.has(r.id) ? COMPARE_WEIGHT : 1) }))
        .sort((a, b) => b.score - a.score);
      const data = await Promise.all(ranked.slice(0, LIMIT).map(({ r }) => r.data()));
      if (mine !== seq) return;
      const terms = q.toLocaleLowerCase().split(/\s+/).filter(Boolean);
      list.replaceChildren(...data.map((d, i) => row(d, i, terms)));
      input.setAttribute("aria-expanded", String(data.length > 0));
      select(data.length ? 0 : -1);
      const total = res.results.length;
      if (!total) say(fill(str.none, { q: q.trim() }));
      else {
        const count = fill(total === 1 ? str.count[0] : str.count[1], { n: total });
        say(total > LIMIT ? `${count} · ${fill(str.more, { shown: LIMIT, total })}` : count);
      }
    };

    const open = () => {
      if (dialog.open) return;
      dialog.showModal();
      input.select();
      if (pagefind) {
        if (!input.value) say(str.idle);
        return;
      }
      say(str.loading);
      void load().then((pf) => {
        if (pf && !input.value) say(str.idle);
      });
    };
    const close = () => dialog.close();

    for (const b of openers) {
      b.hidden = false;
      b.addEventListener("click", open);
    }

    addEventListener("keydown", (e) => {
      if (e.defaultPrevented || e.isComposing) return;
      const t = e.target as HTMLElement | null;
      const typing = t?.closest("input, textarea, select, [contenteditable]:not([contenteditable=false])");
      if ((e.key === "k" || e.key === "K") && (e.metaKey || e.ctrlKey) && !e.altKey) {
        e.preventDefault();
        if (dialog.open) input.select();
        else open();
      } else if (e.key === "/" && !typing && !e.metaKey && !e.ctrlKey && !e.altKey) {
        e.preventDefault();
        open();
      }
    });

    input.addEventListener("input", () => {
      clearTimeout(timer);
      timer = setTimeout(() => void run(input.value), DEBOUNCE);
    });

    input.addEventListener("keydown", (e) => {
      if (e.isComposing) return; // an IME is converting Japanese: its keys are not ours
      if (e.key === "ArrowDown" || e.key === "ArrowUp") {
        e.preventDefault();
        select(active + (e.key === "ArrowDown" ? 1 : -1));
      } else if (e.key === "Enter") {
        const cur = options()[active];
        if (cur) {
          e.preventDefault();
          cur.click();
        }
      } else if (e.key === "Escape") {
        // type=search clears itself on the first Escape; close instead, keeping the query for the next open.
        e.preventDefault();
        close();
      }
    });

    dialog.querySelector("[data-search-close]")?.addEventListener("click", close);
    // A click on the dialog box itself (not its contents) is a click on the backdrop.
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) close();
    });
    // Following a same-page hash link leaves the dialog open over the target; close it first.
    list.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) close();
    });
  }
</script>

<style>
  .search-open {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    min-block-size: 2.75rem;
    min-inline-size: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    font: inherit;
    cursor: pointer;
  }
  .search-open[hidden] {
    display: none;
  }
  .search-open:hover > span {
    text-decoration: underline;
    text-decoration-color: var(--shu);
    text-decoration-thickness: 2px;
  }
  .glass {
    flex: none;
    color: var(--ink-2);
  }
  kbd {
    display: inline-block;
    min-inline-size: 1.5em;
    padding: 0 0.3em;
    border: 1px solid var(--axis);
    border-radius: 2px;
    color: var(--ink-2);
    font-family: var(--f-mono);
    font-size: var(--s-14);
    line-height: 1.4;
    text-align: center;
  }
  @media (max-width: 52rem) {
    .search-open .hint {
      display: none;
    }
  }

  /* The dialog keeps the UA `display: none` until it is open. */
  .search {
    inline-size: min(44rem, calc(100% - 2rem));
    max-inline-size: none;
    max-block-size: min(36rem, calc(100dvh - 8rem));
    margin-block: 10vh auto;
    margin-inline: auto;
    padding: 0;
    border: 1px solid var(--ink);
    border-block-start: 3px solid var(--ink);
    border-radius: 0;
    background: var(--raised);
    color: var(--ink);
    overflow: hidden;
  }
  .search[open] {
    display: flex;
    flex-direction: column;
  }
  .search::backdrop {
    background: rgb(10 12 14 / 0.45);
  }

  .s-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-inline: 1rem 0.5rem;
    border-block-end: 2px solid var(--ink);
  }
  .s-input {
    flex: 1;
    min-inline-size: 0;
    min-block-size: 3.5rem;
    border: 0;
    padding: 0;
    background: none;
    color: var(--ink);
    font: inherit;
    font-size: var(--s-20);
  }
  .s-input::placeholder {
    color: var(--ink-3);
    opacity: 1;
  }
  .s-input:focus-visible {
    outline: none; /* the bar's 朱 rule shows focus instead */
  }
  .s-bar:focus-within {
    border-block-end-color: var(--shu);
  }
  .s-input::-webkit-search-cancel-button {
    display: none;
  }
  .s-close {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-block-size: 2.75rem;
    min-inline-size: 2.75rem;
    padding: 0 0.25rem;
    border: 0;
    background: none;
    color: var(--ink-2);
    font: inherit;
    font-size: var(--s-15);
    cursor: pointer;
  }
  /* On a keyboard screen the esc chip is the visible label; the word stays for assistive tech. */
  .s-close-text {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .s-results {
    flex: 1 1 auto;
    min-block-size: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .s-results:empty {
    display: none;
  }
  /* Rows are built in the script, so they carry no scoped-style attribute. */
  .s-results :global(li) {
    border-block-end: 1px solid var(--rule);
  }
  .s-results :global([role="option"]) {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 0 1rem;
    padding: 0.75rem 1rem 0.75rem calc(1rem - 3px);
    border-inline-start: 3px solid transparent;
    text-decoration: none;
    color: var(--ink);
  }
  .s-results :global([role="option"][aria-selected="true"]) {
    background: var(--selected);
    border-inline-start-color: var(--shu);
  }
  .s-results :global(.s-kind) {
    padding-block-start: 0.2rem;
    color: var(--ink-2);
    font-size: var(--s-14);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .s-results :global(.s-kind:lang(ja)) {
    letter-spacing: 0;
    text-transform: none;
  }
  .s-results :global(.s-kind:lang(ja))::before {
    content: "【";
  }
  .s-results :global(.s-kind:lang(ja))::after {
    content: "】";
  }
  .s-results :global(.s-body) {
    display: grid;
    gap: 0.125rem;
    min-inline-size: 0;
  }
  .s-results :global(.s-title) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.5rem;
  }
  .s-results :global(.s-word) {
    font-family: var(--f-head);
    font-weight: 800;
    font-size: var(--s-20);
    line-height: 1.3;
  }
  .s-results :global(.s-word:lang(ja)) {
    font-feature-settings: "palt";
  }
  .s-results :global(.s-where) {
    color: var(--ink-2);
    font-size: var(--s-15);
    font-weight: 600;
  }
  .s-results :global(.s-where)::before {
    content: "· ";
    color: var(--ink-3);
  }
  .s-results :global(.s-excerpt) {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    color: var(--ink-2);
    font-size: var(--s-15);
    line-height: 1.6;
  }
  .s-results :global(mark) {
    background: none;
    color: var(--ink);
    font-weight: 600;
    /* An underline wash in a neutral tone, readable in both themes; the weight change is the second cue. */
    box-shadow: inset 0 -0.38em 0 color-mix(in srgb, var(--axis) 32%, transparent);
  }

  .s-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
    padding: 0.625rem 1rem;
    border-block-start: 1px solid var(--rule);
    color: var(--ink-2);
    font-size: var(--s-14);
    line-height: 1.5;
  }
  .s-results:empty + .s-foot {
    border-block-start: 0;
  }
  .s-foot p {
    margin: 0;
  }
  .s-keys {
    display: flex;
    gap: 1rem;
  }
  .s-keys kbd {
    margin-inline-end: 0.125rem;
  }

  @media (max-width: 40rem), (hover: none) {
    .search {
      inline-size: 100%;
      max-block-size: 100dvh;
      block-size: 100dvh;
      margin: 0;
      border: 0;
    }
    .s-esc,
    .s-keys {
      display: none;
    }
    .s-close-text {
      position: static;
      inline-size: auto;
      block-size: auto;
      clip-path: none;
    }
    .s-results :global([role="option"]) {
      grid-template-columns: minmax(0, 1fr);
      padding-inline-end: 0.75rem;
    }
    .s-results :global(.s-kind) {
      padding-block-start: 0;
    }
    /* Status sits under the bar, where the on-screen keyboard cannot cover it. */
    .s-bar {
      order: -2;
    }
    .s-foot {
      order: -1;
      border-block-start: 0;
      border-block-end: 1px solid var(--rule);
    }
    .s-results:empty + .s-foot {
      border-block-end: 0;
    }
  }
</style>
