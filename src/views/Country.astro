---
import Claim from "../components/Claim.astro";
import { type CountryId, CULTURE_MAP_SCALES, HOFSTEDE_DIMENSIONS, THEME_IDS } from "../data/schema.ts";
import { dict, themeNames } from "../i18n/dict.ts";
import type { Lang } from "../i18n/ui.ts";
import Base from "../layouts/Base.astro";
import { country, countryMeta, isTranslated } from "../lib/content.ts";

interface Props {
  lang: Lang;
  id: CountryId;
}
const { lang, id } = Astro.props;
const t = dict[lang];
const c = country(lang, id)!;
const meta = countryMeta(id);
const translated = isTranslated(lang, id);
---

<Base lang={lang} title={c.name} description={c.oneLiner}>
  <article class="country" lang={translated ? lang : "ja"}>
    <header class="page-head">
      <h1>{c.name}</h1>
      <p class="lead">{c.oneLiner}</p>
      {!translated && <p class="notice" lang={lang}>{t["country.untranslated"]}</p>}
      <p>{c.intro}</p>
    </header>

    <nav class="toc" aria-label={t["nav.themes"]}>
      {THEME_IDS.map((th) => <a href={`#${th}`}>{themeNames[lang][th]}</a>)}
    </nav>

    {
      THEME_IDS.map((th) => (
        <section id={th} aria-labelledby={`h-${th}`}>
          <h2 id={`h-${th}`}>{themeNames[lang][th]}</h2>
          <ul class="claims">
            {c.themes[th].map((claim) => (
              <Claim claim={claim} lang={lang} />
            ))}
          </ul>
        </section>
      ))
    }

    <section aria-labelledby="h-variance">
      <h2 id="h-variance">{t["country.variance"]}</h2>
      <ul class="variance">{c.variance.map((v) => <li>{v}</li>)}</ul>
    </section>
  </article>

  {
    meta && (
      <section class="scores" aria-labelledby="h-hofstede">
        <h2 id="h-hofstede">{t["country.hofstede"]}</h2>
        <div class="table-wrap" tabindex="0">
          <table>
            <thead>
              <tr>
                <td />
                {HOFSTEDE_DIMENSIONS.map((d) => (
                  <th scope="col">{d.toUpperCase()}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {meta.hofstede.map((h) => (
                <tr>
                  <th scope="row">{h.country}</th>
                  {HOFSTEDE_DIMENSIONS.map((d) => (
                    <td>{h.scores[d] ?? "—"}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <h2>{t["country.cultureMap"]}</h2>
        <div class="table-wrap" tabindex="0">
          <table>
            <tbody>
              {CULTURE_MAP_SCALES.map((s) => (
                <tr>
                  <th scope="row">{s}</th>
                  <td>{meta.cultureMap[s].step ?? "—"}</td>
                  <td>{meta.cultureMap[s].note ?? ""}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  }
</Base>
