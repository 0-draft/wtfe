---
import Claim from "../components/Claim.astro";
import MeyerGrid from "../components/MeyerGrid.astro";
import RunningHead from "../components/RunningHead.astro";
import ThumbIndex from "../components/ThumbIndex.astro";
import type { ThemeId } from "../data/schema.ts";
import { browse, themeCodes, themeDefinitions } from "../i18n/browse.ts";
import { confidenceNames, dict, themeNames } from "../i18n/dict.ts";
import { type Lang, localePath } from "../i18n/ui.ts";
import Base from "../layouts/Base.astro";
import { DISPLAY_CODE } from "../lib/codes.ts";
import { claimsByTheme, country, isTranslated } from "../lib/content.ts";
import { countConfidence } from "../lib/evidence.ts";
import { THEME_SCALES } from "../lib/theme-scales.ts";

interface Props {
  lang: Lang;
  theme: ThemeId;
}
const { lang, theme } = Astro.props;
const t = dict[lang];
const b = browse[lang];
const other: Lang = lang === "en" ? "ja" : "en";
const name = themeNames[lang][theme];
const groups = claimsByTheme(lang, theme);
const total = countConfidence(groups.flatMap((g) => g.claims));
const levels = ["strong", "medium", "weak"] as const;
const scaleKeys = [...THEME_SCALES[theme].meyer, ...THEME_SCALES[theme].hofstede];
---

<Base lang={lang} title={name} description={themeDefinitions[lang][theme]} section="themes">
  <RunningHead slot="running-head" word={name} sub={b["theme.definition"]} />
  <div class="with-thumb">
    <article class="theme-page">
      <header class="headword" data-rh={b["theme.definition"]}>
        <h1>{name}</h1>
        <p class="hw-gloss" data-pagefind-ignore="all">
          <span lang={other}>{themeNames[other][theme]}</span>
          <span class={`hw-code${lang === "ja" ? " code-ja" : ""}`}>{themeCodes[lang][theme]}</span>
        </p>
        <p class="lead">{themeDefinitions[lang][theme]}</p>
        <p class="totals">
          <span>{t["home.claims"](total.total)}</span>
          {
            levels.map((lv) =>
              total[lv] ? (
                <span>
                  <span class="usage" data-level={lv}>
                    {confidenceNames[lang][lv]}
                  </span>{" "}
                  <span class="mono">{total[lv]}</span>
                </span>
              ) : null,
            )
          }
        </p>
      </header>

      <section class="section" id="scales" data-rh={b["theme.glance"]} aria-labelledby="h-scales">
        <h2 id="h-scales">{b["theme.glance"]}</h2>
        <p class="section-lead">{scaleKeys.length ? b["theme.glanceLead"] : b["theme.glanceNoScales"]}</p>
        <MeyerGrid lang={lang} theme={theme} scales={scaleKeys} />
      </section>

      {
        groups.map(({ country: c, claims }) => {
          const n = countConfidence(claims);
          const gloss = country(other, c.id)?.name;
          return (
            <section
              class="section sub"
              id={c.id}
              data-rh={c.name}
              aria-labelledby={`h-${c.id}`}
              lang={isTranslated(lang, c.id) ? lang : "ja"}
            >
              <h2 id={`h-${c.id}`}>
                {c.name}
                <span class="h-aside" data-pagefind-ignore="all">
                  {gloss && <span lang={other}>{gloss}</span>}
                  <span class="mono sub-code">{DISPLAY_CODE[c.id]}</span>
                  <span>{t["home.claims"](n.total)}</span>
                </span>
              </h2>
              <ul class="entries">
                {claims.map((claim) => (
                  <Claim claim={claim} lang={lang} />
                ))}
              </ul>
              <p class="to-country">
                <a href={localePath(lang, `/countries/${c.id}/#${theme}`)}>{b["theme.countryLink"](c.name)} →</a>
              </p>
            </section>
          );
        })
      }
    </article>
    <ThumbIndex lang={lang} href={`/themes/${theme}/#{id}`} />
  </div>
</Base>

<style>
  .totals {
    display: flex;
    flex-wrap: wrap;
    gap: 0.125rem 1rem;
    align-items: baseline;
    margin: 0;
    font-size: var(--s-14);
    color: var(--ink-2);
  }
  .code-ja {
    font-family: var(--f-body);
    font-weight: 600;
  }
  .sub > h2 .h-aside {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0 0.75rem;
  }
  .sub-code {
    color: var(--ink);
    font-weight: 500;
    border: 1px solid var(--ink);
    padding: 0 0.375rem;
    border-radius: 2px;
    line-height: 1.4;
  }
  .entries {
    padding: 0;
    margin: 0;
  }
  .to-country {
    font-size: var(--s-15);
    font-weight: 600;
    margin: 0;
  }
  .to-country a {
    display: inline-block;
    padding-block: 0.625rem;
  }
</style>
