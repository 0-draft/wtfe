---
import { COUNTRY_IDS, type CountryId } from "../data/schema.ts";
import { compareDict } from "../i18n/compare.ts";
import { cultureMapText } from "../i18n/scales.ts";
import { type Lang, localePath } from "../i18n/ui.ts";
import Base from "../layouts/Base.astro";
import { DISPLAY_CODE } from "../lib/codes.ts";
import { biggestGaps, cultureMapDeltas, type Pair, pairSlug } from "../lib/compare.ts";
import { noun, stepsLabel } from "../lib/compare-text.ts";
import { country, countryMeta } from "../lib/content.ts";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = compareDict[lang];
const name = (id: CountryId) => country(lang, id)!.name;
const obj = (id: CountryId) => noun(lang, id, name(id)).object;
const subj = (id: CountryId) => noun(lang, id, name(id)).subject;
const href = (p: Pair) => localePath(lang, `/compare/${pairSlug(p)}/`);
const template = localePath(lang, "/compare/__A__-vs-__B__/");

/** Pairs people often work across; each shown with its largest Culture Map gap. */
const SUGGESTED: Pair[] = [
  ["jp", "us"],
  ["jp", "de"],
  ["us", "in"],
  ["de", "fr"],
  ["kr", "nl"],
  ["gb", "il"],
  ["cn", "nordics"],
  ["pl", "br"],
];
const suggested = SUGGESTED.map((p) => {
  const top = biggestGaps(cultureMapDeltas(countryMeta(p[0])!, countryMeta(p[1])!), 1)[0];
  return {
    pair: p,
    label: t["index.cellName"](obj(p[0]), subj(p[1])),
    gap: top
      ? t["index.biggest"](cultureMapText[lang][top.key].name, stepsLabel(lang, Math.abs(top.delta!)))
      : t["index.none"],
  };
});
---

<Base lang={lang} title={t["index.title"]} section="compare">
  <header class="page-head">
    <h1>{t["index.title"]}</h1>
    <p class="lead measure">{t["index.lead"]}</p>
  </header>

  <form class="picker" data-index-picker data-template={template} aria-labelledby="picker-h" hidden>
    <h2 id="picker-h" class="sr-only">{t["index.pickerHeading"]}</h2>
    <label class="field field-a">
      <span class="field-label">{t["pick.from"]}</span>
      <select name="from" data-pick="a">
        <option value="">{t["index.choose"]}</option>
        {COUNTRY_IDS.map((id) => <option value={id}>{name(id)}</option>)}
      </select>
    </label>
    <span class="arrow" aria-hidden="true">→</span>
    <label class="field field-b">
      <span class="field-label">{t["pick.to"]}</span>
      <select name="to" data-pick="b">
        <option value="">{t["index.choose"]}</option>
        {COUNTRY_IDS.map((id) => <option value={id}>{name(id)}</option>)}
      </select>
    </label>
    <a class="go" href={localePath(lang, "/compare/")} data-go aria-disabled="true" aria-describedby="go-hint">{t["index.go"]}</a>
    <p id="go-hint" class="go-hint" data-go-hint>{t["index.goHint"]}</p>
  </form>

  <section class="section" aria-labelledby="suggested-h">
    <h2 id="suggested-h">{t["index.suggested"]}</h2>
    <ul class="suggested">
      {
        suggested.map((s) => (
          <li>
            <a href={href(s.pair)}>
              <span class="s-codes mono" aria-hidden="true">
                <span class="c-a">{DISPLAY_CODE[s.pair[0]]}</span> → <span class="c-b">{DISPLAY_CODE[s.pair[1]]}</span>
              </span>
              <span class="s-label">{s.label}</span>
            </a>
            <span class="s-gap">{s.gap}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section" aria-labelledby="all-h">
    <h2 id="all-h">{t["index.all"]}</h2>
    <p class="section-lead">{t["index.allLead"]}</p>
    <div class="matrix">
      <p class="m-head" aria-hidden="true">
        <span></span>
        {COUNTRY_IDS.map((id) => <span class="mono">{DISPLAY_CODE[id]}</span>)}
      </p>
      <ul class="m-rows">
        {
          COUNTRY_IDS.map((from) => (
            <li class="m-row">
              <h3 class="m-from" id={`from-${from}`}>
                {t["index.rowFrom"](obj(from))}
              </h3>
              <ul class="m-cells" aria-labelledby={`from-${from}`}>
                {COUNTRY_IDS.map((to) =>
                  to === from ? (
                    <li class="m-self" aria-hidden="true">
                      <span class="mono">{DISPLAY_CODE[to]}</span>
                    </li>
                  ) : (
                    <li>
                      <a href={href([from, to])} title={t["index.cellName"](obj(from), subj(to))}>
                        <span class="mono" aria-hidden="true">
                          {DISPLAY_CODE[to]}
                        </span>
                        <span class="sr-only">{t["index.cellName"](obj(from), subj(to))}</span>
                      </a>
                    </li>
                  ),
                )}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<script>
  // The form is revealed only with JS: without it the matrix below is the way in. The Go link follows the selects.
  for (const form of document.querySelectorAll<HTMLFormElement>("[data-index-picker]")) {
    const template = form.dataset.template ?? "";
    const sa = form.querySelector<HTMLSelectElement>('[data-pick="a"]');
    const sb = form.querySelector<HTMLSelectElement>('[data-pick="b"]');
    const go = form.querySelector<HTMLAnchorElement>("[data-go]");
    const hint = form.querySelector<HTMLElement>("[data-go-hint]");
    if (!sa || !sb || !go) continue;
    const fallback = go.href;
    const ready = () => sa.value !== "" && sb.value !== "" && sa.value !== sb.value;
    const sync = () => {
      const ok = ready();
      go.href = ok ? template.replace("__A__", sa.value).replace("__B__", sb.value) : fallback;
      if (ok) go.removeAttribute("aria-disabled");
      else go.setAttribute("aria-disabled", "true");
      if (hint) hint.hidden = ok;
    };
    sa.addEventListener("change", sync);
    sb.addEventListener("change", sync);
    go.addEventListener("click", (e) => {
      if (!ready()) e.preventDefault();
    });
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      if (ready()) location.assign(go.href);
    });
    sync();
    form.hidden = false;
  }
</script>

<style>
  .page-head {
    margin-block-end: 2rem;
  }
  .page-head h1 {
    font-size: var(--s-44);
    margin-block-end: 0.75rem;
  }
  .picker {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 0.75rem 1rem;
    padding-block: 1.25rem 0;
  }
  .picker[hidden] {
    display: none;
  }
  .field {
    display: grid;
    gap: 0.25rem;
    min-inline-size: 0;
  }
  .field-label {
    font-size: var(--s-14);
    font-weight: 600;
    color: var(--ink-2);
  }
  .field select {
    font: inherit;
    font-size: var(--s-17);
    min-block-size: 44px;
    min-inline-size: 12rem;
    max-inline-size: 100%;
    padding: 0.375rem 0.5rem;
    color: var(--ink);
    background: var(--raised);
    border: 1px solid var(--axis);
    border-block-end-width: 3px;
    border-radius: 2px;
  }
  .field-a select {
    border-block-end-color: var(--shu);
  }
  .field-b select {
    border-block-end-color: var(--ai);
  }
  .arrow {
    padding-block-end: 0.6rem;
    color: var(--ink-2);
  }
  @media (max-width: 30rem) {
    .arrow {
      display: none;
    }
  }
  .matrix .mono {
    font-size: var(--s-14);
  }
  .go {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    padding-inline: 1.25rem;
    background: var(--ink);
    color: var(--paper);
    font-weight: 600;
    text-decoration: none;
    border-radius: 2px;
  }
  .go[aria-disabled="true"] {
    background: transparent;
    color: var(--ink-2);
    border: 1px dashed var(--axis);
    cursor: not-allowed;
  }
  .go-hint {
    flex-basis: 100%;
    margin: 0;
    font-size: var(--s-14);
    color: var(--ink-2);
  }
  .suggested {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: 0 2rem;
  }
  .suggested li {
    display: grid;
    gap: 0.125rem;
    padding-block: 0.75rem;
    border-block-end: 1px solid var(--rule);
  }
  .suggested a {
    display: grid;
    gap: 0.125rem;
    text-decoration: none;
    padding-block: 0.125rem;
  }
  .suggested a:hover .s-label {
    text-decoration: underline;
  }
  .s-label {
    font-weight: 600;
  }
  .s-gap {
    font-size: var(--s-14);
    color: var(--ink-2);
  }
  .c-a {
    color: var(--shu);
  }
  .c-b {
    color: var(--ai);
  }
  .matrix {
    --m-label: 11rem;
    font-size: var(--s-14);
  }
  .m-head,
  .m-cells {
    display: grid;
    grid-template-columns: repeat(14, minmax(0, 1fr));
  }
  .m-head {
    grid-template-columns: var(--m-label) repeat(14, minmax(0, 1fr));
    margin: 0;
    color: var(--ink-3);
    text-align: center;
    border-block-end: 1px solid var(--ink);
    padding-block: 0.25rem;
  }
  .m-rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .m-row {
    display: grid;
    grid-template-columns: var(--m-label) minmax(0, 1fr);
    align-items: center;
    border-block-end: 1px solid var(--rule);
  }
  .m-from {
    font-family: var(--f-body);
    font-size: var(--s-14);
    font-weight: 600;
    color: var(--ink);
    padding-inline-end: 0.5rem;
  }
  .m-cells {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .m-cells li {
    text-align: center;
  }
  .m-cells a,
  .m-self span {
    display: flex;
    align-items: center;
    justify-content: center;
    min-block-size: 44px;
    min-inline-size: 0;
  }
  .m-cells a {
    text-decoration: none;
    color: var(--ai);
  }
  .m-cells a:hover {
    background: var(--raised);
    text-decoration: underline;
  }
  .m-self span {
    color: var(--shu);
    font-weight: 500;
  }
  @media (max-width: 52rem) {
    .m-head {
      display: none;
    }
    .m-row {
      grid-template-columns: minmax(0, 1fr);
      padding-block: 0.5rem;
    }
    .m-cells {
      grid-template-columns: repeat(7, minmax(0, 1fr));
    }
  }
</style>
