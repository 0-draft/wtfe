---
import { THEME_IDS } from "../data/schema.ts";
import { browse, themeCodes, themeDefinitions } from "../i18n/browse.ts";
import { confidenceNames, themeNames } from "../i18n/dict.ts";
import { cultureMapText, hofstedeText, scaleSlug } from "../i18n/scales.ts";
import { type Lang, localePath } from "../i18n/ui.ts";
import Base from "../layouts/Base.astro";
import { countries } from "../lib/content.ts";
import { evidenceMap, THEME_SCALES } from "../lib/evidence.ts";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const b = browse[lang];
const other: Lang = lang === "en" ? "ja" : "en";
const map = evidenceMap(countries(lang));
const levels = ["strong", "medium", "weak"] as const;
const sep = lang === "ja" ? "、" : ", ";
---

<Base lang={lang} title={b["themes.title"]} description={b["themes.lead"]} section="themes">
  <header class="headword">
    <h1>{b["themes.title"]}</h1>
    <p class="lead">{b["themes.lead"]}</p>
  </header>

  <ul class="themes">
    {
      THEME_IDS.map((th) => {
        const n = map.themes[th];
        const withClaims = map.rows.filter((r) => r.cells.some((c) => c.theme === th && c.counts.total > 0)).length;
        const scales = [
          ...THEME_SCALES[th].meyer.map((s) => ({ href: `/scales/${scaleSlug(s, "meyer")}/`, label: cultureMapText[lang][s].name })),
          ...THEME_SCALES[th].hofstede.map((d) => ({
            href: `/scales/${scaleSlug(d, "hofstede")}/`,
            label: `Hofstede ${hofstedeText[lang][d].name}`,
          })),
        ];
        return (
          <li class="theme" id={th}>
            <h2 class="hw">
              <a href={localePath(lang, `/themes/${th}/`)}>{themeNames[lang][th]}</a>
            </h2>
            <p class="gloss">
              <span lang={other}>{themeNames[other][th]}</span>
              <span class={`code${lang === "en" ? " mono" : ""}`}>{themeCodes[lang][th]}</span>
            </p>
            <p class="def">{themeDefinitions[lang][th]}</p>
            <p class="counts">
              <span>{b["themes.counts"](n.total, withClaims)}</span>
              {levels.map((lv) =>
                n[lv] ? (
                  <span>
                    <span class="usage" data-level={lv}>
                      {confidenceNames[lang][lv]}
                    </span>{" "}
                    <span class="mono">{n[lv]}</span>
                  </span>
                ) : null,
              )}
            </p>
            {scales.length > 0 && (
              <p class="scales">
                <span class="scales-label">{b["theme.scales"]}:</span>{" "}
                {scales.map((s, i) => (
                  <>
                    {i > 0 && sep}
                    <a href={localePath(lang, s.href)}>{s.label}</a>
                  </>
                ))}
              </p>
            )}
          </li>
        );
      })
    }
  </ul>
</Base>

<style>
  .headword h1 {
    margin-block-end: 0.75rem;
  }
  .themes {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .theme {
    border-block-start: 1px solid var(--ink);
    padding-block: 0.875rem 1.5rem;
    max-inline-size: var(--measure);
  }
  .hw {
    font-size: var(--s-24);
    font-weight: 800;
    line-height: 1.3;
  }
  .hw a {
    text-decoration: none;
  }
  .hw a:hover {
    text-decoration: underline;
  }
  .gloss {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    align-items: baseline;
    margin: 0.25rem 0 0.5rem;
    color: var(--ink-2);
  }
  .code {
    font-size: var(--s-14);
    font-weight: 600;
    color: var(--ink);
    border: 1px solid var(--ink);
    padding: 0 0.375rem;
    border-radius: 2px;
  }
  .def {
    margin-block-end: 0.5rem;
  }
  .counts,
  .scales {
    display: flex;
    flex-wrap: wrap;
    gap: 0.125rem 1rem;
    align-items: baseline;
    margin: 0;
    font-size: var(--s-14);
    color: var(--ink-2);
  }
  .scales {
    display: block;
    margin-block-start: 0.375rem;
    line-height: 2;
  }
  .scales a {
    color: var(--ink);
    padding-block: 0.5rem;
  }
  .scales-label {
    font-weight: 600;
  }
</style>
