---
import RunningHead from "../components/RunningHead.astro";
import { ALL_SCALES, countryNames, scaleHref, scaleItems, scaleText } from "../components/strip/data.ts";
import Strip from "../components/strip/Strip.astro";
import VantageStrip from "../components/strip/VantageStrip.tsx";
import { themeNames } from "../i18n/dict.ts";
import { builtFrom, poleNotes } from "../i18n/scale-pages.ts";
import { stripText } from "../i18n/strip.ts";
import { type Lang, localePath } from "../i18n/ui.ts";
import Base from "../layouts/Base.astro";
import { type StripKey, scaleKind } from "../lib/strip.ts";
import { SCALE_THEMES } from "../lib/theme-scales.ts";

interface Props {
  lang: Lang;
  scale: StripKey;
}
const { lang, scale } = Astro.props;
const other: Lang = lang === "en" ? "ja" : "en";
const t = stripText[lang];
const kind = scaleKind(scale);
const text = scaleText(lang, scale);
const otherName = scaleText(other, scale).name;
const framework = kind === "meyer" ? t["scales.meyer"] : t["scales.hofstede"];
const [leftNote, rightNote] = poleNotes[lang][scale];
const siblings = ALL_SCALES.filter((k) => scaleKind(k) === kind);
const staticId = `strip-${scale}`;
const themes = SCALE_THEMES[scale];
---

<Base lang={lang} title={text.name} description={text.gloss} section="scales">
  <RunningHead slot="running-head" word={text.name} sub={framework} />
  <article class="scale">
    <header class="headword">
      <p class="kicker"><a href={`${localePath(lang, "/scales/")}#${kind}`}>{framework}</a></p>
      <h1>{text.name}</h1>
      <p class="hw-gloss"><span lang={other}>{otherName}</span></p>
      <p class="lead">{text.gloss}</p>
    </header>

    <section class="figure-block" aria-label={t["scale.vantage"]} data-rh={framework}>
      <VantageStrip
        client:load
        lang={lang}
        scale={scale}
        text={text}
        items={scaleItems(scale)}
        names={countryNames(lang)}
        staticId={staticId}
        size="large"
      />
      <Strip lang={lang} scale={scale} size="large" about={false} id={staticId} />
    </section>

    <section class="section" id="poles" data-rh={t["scale.poles"]}>
      <h2>{t["scale.poles"]}</h2>
      <dl class="poles measure">
        <div>
          <dt><span class="pole-side">{t["scale.leftPole"]}</span> {text.left}</dt>
          <dd>{leftNote}</dd>
        </div>
        <div>
          <dt><span class="pole-side">{t["scale.rightPole"]}</span> {text.right}</dt>
          <dd>{rightNote}</dd>
        </div>
      </dl>
    </section>

    <section class="section" id="built-from" data-rh={t["scale.builtFrom"]}>
      <h2>{t["scale.builtFrom"]}</h2>
      <div class="measure">
        <p>{builtFrom[lang][scale]}</p>
        <p>{kind === "meyer" ? t["scales.meyerIntro"] : t["scales.hofstedeIntro"]}</p>
        <p class="limits">
          {kind === "meyer" ? t["scales.meyerLimits"] : t["scales.hofstedeLimits"]}
          {" "}<a href={localePath(lang, "/method/")}>{t["scales.method"]}</a>
        </p>
      </div>
    </section>

    <section class="section" id="related" data-rh={t["scale.seeAlso"]}>
      <h2>{t["scale.seeAlso"]}</h2>
      {
        themes.length > 0 && (
          <>
            <h3>{t["scale.related"]}</h3>
            <ul class="links">
              {themes.map((th) => (
                <li>
                  <a href={localePath(lang, `/themes/${th}/`)}>{themeNames[lang][th]}</a>
                </li>
              ))}
            </ul>
          </>
        )
      }
      <h3>{framework}</h3>
      <ul class="links">
        {
          siblings.map((k) => (
            <li>
              {k === scale ? (
                <span aria-current="page">{scaleText(lang, k).name}</span>
              ) : (
                <a href={scaleHref(lang, k)}>{scaleText(lang, k).name}</a>
              )}
            </li>
          ))
        }
      </ul>
      <p><a href={localePath(lang, "/scales/")}>{t["scales.all"]}</a></p>
    </section>
  </article>
</Base>

<style>
  .kicker {
    font-size: var(--s-14);
    font-weight: 600;
    color: var(--ink-2);
    margin-block-end: 0.25rem;
  }
  .kicker a {
    text-decoration: none;
    display: inline-block;
    padding-block: 0.375rem;
  }
  .kicker a:hover {
    text-decoration: underline;
  }
  .figure-block {
    margin-block-start: 1rem;
  }
  .poles {
    margin: 0;
    display: grid;
    gap: 1.25rem;
  }
  .poles dt {
    font-weight: 700;
  }
  .pole-side {
    font-size: var(--s-14);
    font-weight: 600;
    color: var(--ink-2);
    margin-inline-end: 0.375rem;
  }
  .poles dd {
    margin: 0.25rem 0 0;
  }
  .limits {
    color: var(--ink-2);
  }
  .links {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
  }
  .links a,
  .links span {
    display: inline-block;
    padding-block: 0.625rem;
  }
  .links span[aria-current] {
    font-weight: 700;
    color: var(--shu);
  }
  h3 {
    margin-block: 1rem 0.25rem;
    font-size: var(--s-17);
  }
</style>
